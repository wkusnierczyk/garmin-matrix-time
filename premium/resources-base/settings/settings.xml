<settings xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://developer.garmin.com/downloads/connect-iq/resources.xsd">

    <!-- The values are the indices TimeSize maps to fonts (#32). -->
    <setting propertyKey="@Properties.timeSize" title="@Strings.TimeSizeTitle">
        <settingConfig type="list">
            <listEntry value="0">@Strings.TimeSizeSmall</listEntry>
            <listEntry value="1">@Strings.TimeSizeMedium</listEntry>
            <listEntry value="2">@Strings.TimeSizeLarge</listEntry>
            <listEntry value="3">@Strings.TimeSizeExtraLarge</listEntry>
            <listEntry value="4">@Strings.TimeSizeExtraExtraLarge</listEntry>
        </settingConfig>
    </setting>

    <!-- The values are percentages of the screen height, used as they are (#53). -->
    <setting propertyKey="@Properties.trailLength" title="@Strings.TrailLengthTitle">
        <settingConfig type="list">
            <listEntry value="25">@Strings.TrailLength25</listEntry>
            <listEntry value="50">@Strings.TrailLength50</listEntry>
            <listEntry value="75">@Strings.TrailLength75</listEntry>
        </settingConfig>
    </setting>

    <!-- The values are the indices TimeStyle reads (#72). Hollow has no effect at S or M,
         and its label says so, since the two settings are on separate lines. -->
    <setting propertyKey="@Properties.timeStyle" title="@Strings.TimeStyleTitle">
        <settingConfig type="list">
            <listEntry value="0">@Strings.TimeStyleFilled</listEntry>
            <listEntry value="1">@Strings.TimeStyleHollow</listEntry>
        </settingConfig>
    </setting>

    <!-- The values are the indices TimeAlign reads (#154). -->
    <setting propertyKey="@Properties.timeAlign" title="@Strings.TimeAlignTitle">
        <settingConfig type="list">
            <listEntry value="0">@Strings.TimeAlignLeft</listEntry>
            <listEntry value="1">@Strings.TimeAlignCenter</listEntry>
            <listEntry value="2">@Strings.TimeAlignRight</listEntry>
        </settingConfig>
    </setting>

    <!-- The values index TimeColor.COLORS (#143). -->
    <setting propertyKey="@Properties.timeColor" title="@Strings.TimeColorTitle">
        <settingConfig type="list">
            <listEntry value="0">@Strings.ColorGreen</listEntry>
            <listEntry value="1">@Strings.ColorWhite</listEntry>
            <listEntry value="2">@Strings.ColorCyan</listEntry>
            <listEntry value="3">@Strings.ColorAmber</listEntry>
            <listEntry value="4">@Strings.ColorOrange</listEntry>
            <listEntry value="5">@Strings.ColorRed</listEntry>
        </settingConfig>
    </setting>

    <!-- The values index RainColor's HEADS and TAILS (#143). The last two are gradients:
         the hue moves from the first colour at the head to the second along the trail. -->
    <setting propertyKey="@Properties.rainColor" title="@Strings.RainColorTitle">
        <settingConfig type="list">
            <listEntry value="0">@Strings.ColorGreen</listEntry>
            <listEntry value="1">@Strings.ColorCyan</listEntry>
            <listEntry value="2">@Strings.ColorBlue</listEntry>
            <listEntry value="3">@Strings.ColorAmber</listEntry>
            <listEntry value="4">@Strings.ColorRed</listEntry>
            <listEntry value="5">@Strings.ColorWhite</listEntry>
            <listEntry value="6">@Strings.RainColorWhiteToGreen</listEntry>
            <listEntry value="7">@Strings.RainColorGreenToTeal</listEntry>
        </settingConfig>
    </setting>

    <!-- The values are the levels AlwaysOnBrightness reads (#161). -->
    <setting propertyKey="@Properties.alwaysOnBrightness" title="@Strings.AlwaysOnBrightnessTitle">
        <settingConfig type="list">
            <listEntry value="0">@Strings.AlwaysOnBrightnessBright</listEntry>
            <listEntry value="1">@Strings.AlwaysOnBrightnessDimmed</listEntry>
            <listEntry value="2">@Strings.AlwaysOnBrightnessDim</listEntry>
        </settingConfig>
    </setting>

    <!-- The values are DateField's OFF and ON (#163). A list rather than a boolean, so that
         the watch's menu steps through it like every other setting. -->
    <setting propertyKey="@Properties.date" title="@Strings.DateTitle">
        <settingConfig type="list">
            <listEntry value="0">@Strings.DateOff</listEntry>
            <listEntry value="1">@Strings.DateOn</listEntry>
        </settingConfig>
    </setting>

</settings>
