<properties xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://developer.garmin.com/downloads/connect-iq/resources.xsd">

    <!-- Premium's settings, joining the settingsSchema marker in resources/properties
         rather than replacing it (#91, #93). The two files merge: this one is on
         Premium's resource path only, so Lite's property table is unchanged.

         timeSize is the time font on the woken screen, as an index into the XXS, XS, S, M,
         L, XL, XXL ladder in TimeSize (#32, #153, #166). 3, M, is the default (#155; it was
         called XL until #166 renamed the sizes), and agrees with the fallback in
         TimeSize.sizeOf. 0, XXS, is Lite's size; Premium draws every size in ExtraBold where
         Lite draws Regular (#144). -->
    <property id="timeSize" type="number">3</property>

    <!-- trailLength is how far down the screen the rain fades to black, as a percentage
         of the screen height, read by TrailLength (#53). It stores the percentage itself,
         not an index, so a new length is one more listEntry in settings.xml. 50 is
         Lite's half screen. -->
    <property id="trailLength" type="number">50</property>

    <!-- timeStyle is the woken time drawn filled or hollow, an index read by TimeStyle
         (#72). 0, filled, is solid digits; neither style is drawn on a box, which is Lite's
         look alone (#174). Hollow applies to S and above only. -->
    <property id="timeStyle" type="number">0</property>

    <!-- timeColor and rainColor are indices into the palettes in TimeColor and RainColor
         (#143), not the colours themselves: a rain entry is a pair of colours, and the
         watch's menu steps through the list in its own order. 0, green, is Lite's colour
         in both. -->
    <property id="timeColor" type="number">0</property>
    <property id="rainColor" type="number">0</property>

    <!-- timeAlign is the woken time at the left, centre or right of the screen, an index
         read by TimeAlign (#154). 1, centre, is Lite's alignment, and the fallback in
         TimeAlign.alignOf. The always-on time stays centred whatever this holds. -->
    <property id="timeAlign" type="number">1</property>

    <!-- alwaysOnBrightness is how bright the always-on time is drawn, an index read by
         AlwaysOnBrightness (#161): 0 bright, the full time colour; 1 dimmed, five sixths
         of it; 2 dim, two thirds, as Lite draws it. 0 is the default, and the fallback in
         AlwaysOnBrightness.levelOf. -->
    <property id="alwaysOnBrightness" type="number">0</property>

    <!-- date is the ISO date under the woken time, 0 off and 1 on, read by DateField
         (#163). 0, off, is the default, and the fallback in DateField.showOf. -->
    <property id="date" type="number">0</property>

    <!-- The presets (#172). presetLoad and presetSave are the phone's two actions: 0 does
         nothing, and 1 to 5 loads or saves that slot, after which the face sets the property
         back to 0; see Presets.applyRequests. presetName1 to presetName5 name the slots, and
         are what the phone can rename. The looks themselves are in Storage, not here, so
         the phone never writes them. Slots 1 to 3 ship with a look, and their names here
         are its name (#183); see Presets.builtIn. -->
    <property id="presetLoad" type="number">0</property>
    <property id="presetSave" type="number">0</property>
    <property id="presetName1" type="string">Green</property>
    <property id="presetName2" type="string">Red</property>
    <property id="presetName3" type="string">Blue</property>
    <property id="presetName4" type="string">Preset 4</property>
    <property id="presetName5" type="string">Preset 5</property>

</properties>
