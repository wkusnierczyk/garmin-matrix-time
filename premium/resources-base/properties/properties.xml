<properties xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://developer.garmin.com/downloads/connect-iq/resources.xsd">

    <!-- Premium's settings, joining the settingsSchema marker in resources/properties
         rather than replacing it (#91, #93). The two files merge: this one is on
         Premium's resource path only, so Lite's property table is unchanged.

         timeSize is the time font on the woken screen, as an index into the S, M, L, XL
         ladder in TimeSize (#32). 0, S, is Lite's size; Premium draws it in ExtraBold
         where Lite draws Regular (#144). -->
    <property id="timeSize" type="number">0</property>

    <!-- trailLength is how far down the screen the rain fades to black, as a percentage
         of the screen height, read by TrailLength (#53). It stores the percentage itself,
         not an index, so a new length is one more listEntry in settings.xml. 50 is
         Lite's half screen. -->
    <property id="trailLength" type="number">50</property>

    <!-- timeStyle is the woken time drawn filled or hollow, an index read by TimeStyle
         (#72). 0, filled, is Lite's style, solid digits on a black box. Hollow applies to the L and XL sizes only. -->
    <property id="timeStyle" type="number">0</property>

    <!-- timeColor and rainColor are indices into the palettes in TimeColor and RainColor
         (#143), not the colours themselves: a rain entry is a pair of colours, and the
         watch's menu steps through the list in its own order. 0, green, is Lite's colour
         in both. -->
    <property id="timeColor" type="number">0</property>
    <property id="rainColor" type="number">0</property>

</properties>
